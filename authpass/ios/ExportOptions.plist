<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  How `xcodebuild -exportArchive` turns the archive into the .ipa that goes to
  App Store Connect. Committed rather than generated, so the export is reviewed
  in a diff like everything else about a release.
-->
<plist version="1.0">
<dict>
	<!--
	  Xcode 15 renamed this from "app-store". The old spelling still works and
	  is what most published examples use, which is worth knowing when reading
	  them against this file.
	-->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>64ZPC769JY</string>

	<!--
	  Manual, and deliberately so. Automatic signing works and is less to
	  maintain, but it means whatever runs the export can create and renew
	  provisioning profiles — and an App Store Connect team key cannot be
	  scoped to one app, so CI would hold a credential able to publish every
	  app in the team. Signing against stored profiles keeps CI's only Apple
	  credential an app-scoped individual key that can upload and nothing else.

	  The cost is that these profiles expire with the certificate and are
	  regenerated by hand, from a laptop, with an Admin key. See
	  docs/apple-signing.md.
	-->
	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<!--
	  Both targets, by bundle id. Omitting the extension does not fail the
	  export; it produces an .ipa Apple rejects at upload, which is a much
	  later and less obvious failure.
	-->
	<key>provisioningProfiles</key>
	<dict>
		<key>design.codeux.authpass.ios</key>
		<string>AuthPass iOS AppStore</string>
		<key>design.codeux.authpass.ios.autofill</key>
		<string>AuthPass iOS AutoFill AppStore</string>
	</dict>

	<!--
	  Load bearing. Left at its default, Xcode rewrites CFBundleVersion and
	  CFBundleShortVersionString during export — which would discard the build
	  number git-buildnumber allocated for this commit and the version from
	  pubspec.yaml.
	-->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<!-- dSYMs go up with the build, so TestFlight crash reports symbolicate. -->
	<key>uploadSymbols</key>
	<true/>

	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
